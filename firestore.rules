rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 200;
    }

    function isValidUserSheetData(data, userId, sheetId) {
      return data.userId == userId
        && data.sheetId == sheetId
        && data.dataJson is string
        && data.dataJson.size() > 0
        && data.dataJson.size() <= 50000;
    }

    // Diagnostic/Connection test document
    match /test/{testId} {
      allow read: if true;
    }

    // User Profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId);
      allow delete: if false;

      // User Sheet Custom Edits
      match /sheets/{sheetId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(sheetId)
          && isValidUserSheetData(incoming(), userId, sheetId);
        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(sheetId);
      }
    }
  }
}
